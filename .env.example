# =============================================================================
# Wallpaper CMS API - environment variables
# Copy to .env and fill in real values. NEVER commit real secrets.
# =============================================================================

NODE_ENV=development
PORT=3000

# Comma-separated list of admin dashboard origins allowed by CORS (browser only).
CORS_ORIGINS=http://localhost:3001
# Express "trust proxy": number of proxy hops in front of the app (e.g. 1 behind a load balancer) or false.
TRUST_PROXY=false

# ---- Database ----
DATABASE_URL=postgresql://wallpaper:change-me@localhost:5432/wallpaper_dev?schema=public

# ---- Admin auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=wallpaper-api
JWT_AUDIENCE=wallpaper-admin
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS). Set false only for plain-http local development.
COOKIE_SECURE=false
# COOKIE_DOMAIN=admin.example.com
# strict | lax | none  (none requires COOKIE_SECURE=true; needed if dashboard and API are cross-site)
COOKIE_SAME_SITE=strict

# ---- Initial admin seed (used only by `npm run db:seed`, not by the running API) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
# Min 12 chars. Remove from the environment after seeding.
SEED_ADMIN_PASSWORD=

# ---- Swagger ----
SWAGGER_ENABLED=true
# Required in production when SWAGGER_ENABLED=true (HTTP Basic auth on /api/docs)
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=

# ---- Rate limiting (per client IP) ----
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_EVENTS_LIMIT=120
THROTTLE_EVENTS_TTL_MS=60000

# ---- Object storage ----
# local = files on disk under LOCAL_STORAGE_PATH, served at /media (development only)
# s3    = any S3-compatible provider (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Backblaze B2...)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
# Trusted base URL for public media links (CDN in production), e.g. https://cdn.example.com
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media

# S3_BUCKET=wallpapers
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000      # only for non-AWS providers
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true               # MinIO / some providers

# ---- Media processing ----
MEDIA_MAX_FILE_SIZE_MB=25
MEDIA_MAX_FILES_PER_UPLOAD=20
MEDIA_MAX_INPUT_PIXELS=100000000
MEDIA_MAX_DIMENSION=12000
MEDIA_MIN_DIMENSION=200
MEDIA_PREVIEW_MAX_DIMENSION=2048
MEDIA_THUMBNAIL_MAX_DIMENSION=480
# 0 disables the periodic sweep of storage objects that have no database row
MEDIA_ORPHAN_CLEANUP_INTERVAL_MINUTES=60

# ---- Public API / analytics ----
PUBLIC_CACHE_TTL_SECONDS=30
ANALYTICS_FLUSH_INTERVAL_MS=5000
ANALYTICS_RAW_EVENT_RETENTION_DAYS=90
# Optional comma-separated allowlist of hosts for banner OPEN_URL actions
BANNER_URL_ALLOWED_HOSTS=
