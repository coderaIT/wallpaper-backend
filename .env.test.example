# Used by the Jest e2e suite (copy to .env.test). Must point at a DISPOSABLE database:
# the tests truncate every table.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallpaper_test?schema=public
JWT_ACCESS_SECRET=test-secret-test-secret-test-secret-123456
COOKIE_SECURE=false
SWAGGER_ENABLED=false
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=https://cdn.test.local
THROTTLE_DEFAULT_LIMIT=100000
THROTTLE_AUTH_LIMIT=100000
THROTTLE_EVENTS_LIMIT=100000
MEDIA_MIN_DIMENSION=16

# Disable public response caching so tests observe changes immediately
PUBLIC_CACHE_TTL_SECONDS=0
TRUST_PROXY=loopback
# Tests flush analytics explicitly
ANALYTICS_FLUSH_INTERVAL_MS=3600000
