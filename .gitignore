# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
coverage/

# generated Prisma client
src/generated/

# environment files (never commit secrets)
.env
.env.*
!.env.example
!.env.test.example

# Uploaded media at the repo root (LOCAL_STORAGE_PATH).
# Keep the leading slash: a bare `storage/` rule also ignores
# src/modules/media/storage, and the build then fails with TS2307.
/storage/

# logs / OS / IDE
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

/src/generated/prisma
